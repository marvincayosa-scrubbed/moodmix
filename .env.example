# Server-side only. Never prefix these with NEXT_PUBLIC_.
GEMINI_API_KEY=
# Optional; defaults to gemini-2.5-flash. Choose a model available to your key.
GEMINI_MODEL=gemini-2.5-flash

# Optional Spotify preview matching. Keep credentials server-side.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Optional two-letter uppercase catalogue market; defaults to US.
SPOTIFY_MARKET=US
